<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Browse service opportunities by category to find the cause that matters most to you.</p>

    <ul class="category-list">
        <% categories.forEach(category => { %>
            <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
        <% }); %>
    </ul>
    
    <% if (isAdmin) { %>
        <p><a href="/new-category">Add a New Category</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
