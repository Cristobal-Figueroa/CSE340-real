<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Discover the next upcoming service projects and find opportunities to make a meaningful impact in your community.</p>

    <ul class="projects-list">
        <% projects.forEach(project => { %>
            <li>
                <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                <p><strong>Organization:</strong> 
                    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                </p>
                <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
            </li>
        <% }); %>
    </ul>
    
    <p><a href="/new-project">Add a New Service Project</a></p>
</main>

<%- include('partials/footer') %>
