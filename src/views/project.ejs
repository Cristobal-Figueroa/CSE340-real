<%- include('partials/header') %>

<main>
    <h2><%= project.title %></h2>
    
    <p><%= project.description %></p>
    
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
    
    <p><strong>Location:</strong> <%= project.location %></p>
    
    <p><strong>Partner Organization:</strong> 
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>
    
    <% if (isAdmin) { %>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    <% } %>
    
    <% if (isLoggedIn) { %>
        <% if (isVolunteering) { %>
            <p><strong>You are volunteering for this project.</strong></p>
            <form action="/remove-volunteer/<%= project.project_id %>" method="POST" style="display: inline;">
                <button type="submit" style="background-color: #dc3545; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-size: 14px;">Remove yourself as a volunteer</button>
            </form>
        <% } else { %>
            <form action="/volunteer/<%= project.project_id %>" method="POST" style="display: inline;">
                <button type="submit" style="background-color: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-size: 14px;">Volunteer for this project</button>
            </form>
        <% } %>
    <% } %>
    
    <% if (categories.length > 0) { %>
        <p><strong>Categories:</strong></p>
        <ul>
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
            <% }); %>
        </ul>
    <% } %>
    
    <% if (isAdmin) { %>
        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
