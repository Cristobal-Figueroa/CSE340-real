<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <div class="dashboard-content">
        <h2>Welcome, <%= name %>!</h2>
        
        <div class="user-info">
            <h3>Your Account Information</h3>
            <p><strong>Name:</strong> <%= name %></p>
            <p><strong>Username:</strong> <%= email %></p>
        </div>

        <div class="dashboard-actions">
            <h3>Quick Actions</h3>
            <ul>
                <li><a href="/organizations">View Organizations</a></li>
                <li><a href="/projects">View Projects</a></li>
                <li><a href="/categories">View Categories</a></li>
            </ul>
        </div>

        <% if (isAdmin) { %>
            <div class="admin-section">
                <h3>Admin Tools</h3>
                <ul>
                    <li><a href="/users">View All Users</a></li>
                </ul>
            </div>
        <% } %>

        <div class="volunteered-projects">
            <h3>My Volunteered Projects (<%= volunteeredProjects ? volunteeredProjects.length : 0 %>)</h3>
            <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
                <ul style="list-style: none; padding: 0;">
                    <% volunteeredProjects.forEach(project => { %>
                        <li style="background-color: #f8f9fa; padding: 15px; margin-bottom: 10px; border-radius: 5px; border-left: 4px solid #28a745;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <a href="/project/<%= project.project_id %>" style="font-size: 18px; font-weight: bold; color: #333; text-decoration: none;"><%= project.title %></a>
                                    <p style="margin: 5px 0 0 0; color: #666; font-size: 14px;">
                                        <strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %> | 
                                        <strong>Organization:</strong> <%= project.organization_name %>
                                    </p>
                                </div>
                                <form action="/remove-volunteer/<%= project.project_id %>" method="POST" style="margin: 0;">
                                    <button type="submit" style="background-color: #dc3545; color: white; padding: 8px 16px; border: none; border-radius: 5px; cursor: pointer; font-size: 13px;">Remove</button>
                                </form>
                            </div>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <p style="color: #666; font-style: italic;">You haven't volunteered for any projects yet.</p>
            <% } %>
        </div>
    </div>

</main>

<%- include('partials/footer') %>
