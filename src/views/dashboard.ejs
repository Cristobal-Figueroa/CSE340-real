<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <div class="dashboard-content">
        <h2>Welcome, <%= name %>!</h2>
        
        <div class="user-info">
            <h3>Your Account Information</h3>
            <p><strong>Name:</strong> <%= name %></p>
            <p><strong>Username:</strong> <%= email %></p>
        </div>

        <div class="dashboard-actions">
            <h3>Quick Actions</h3>
            <ul>
                <li><a href="/organizations">View Organizations</a></li>
                <li><a href="/projects">View Projects</a></li>
                <li><a href="/categories">View Categories</a></li>
            </ul>
        </div>

        <% if (isAdmin) { %>
            <div class="admin-section">
                <h3>Admin Tools</h3>
                <ul>
                    <li><a href="/users">View All Users</a></li>
                </ul>
            </div>
        <% } %>

        <div class="volunteered-projects">
            <h3>My Volunteered Projects</h3>
            <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
                <ul>
                    <% volunteeredProjects.forEach(project => { %>
                        <li>
                            <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                            - <%= new Date(project.date).toLocaleDateString() %>
                            <form action="/remove-volunteer/<%= project.project_id %>" method="POST" style="display: inline;">
                                <button type="submit" style="padding: 2px 8px; font-size: 12px;">Remove</button>
                            </form>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <p>You haven't volunteered for any projects yet.</p>
            <% } %>
        </div>
    </div>

</main>

<%- include('partials/footer') %>
