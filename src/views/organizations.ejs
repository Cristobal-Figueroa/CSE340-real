<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>We partner with outstanding organizations dedicated to making a difference in communities around the world.</p>

    <div class="cards-grid">
        <% organizations.forEach(organization => { %>
            <div class="card">
                <img src="/img/<%= organization.logo_filename %>" alt="<%= organization.name %> Logo">
                <h3><%= organization.name %></h3>
                <p><%= organization.description %></p>
                <p class="contact-email"><strong>Contact:</strong> <%= organization.contact_email %></p>
            </div>
        <% }); %>
    </div>
</main>

<%- include('partials/footer') %>
